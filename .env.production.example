# Values for docker-compose.prod.yml (docker compose --env-file .env.production ...).
# Copy to .env.production and fill in real values. Do not commit the real file.
# Secrets for the API itself (JWT_SECRET, CORS_ORIGIN) live in apps/api/.env —
# see apps/api/.env.example.

# Strong, unique Postgres credentials — NOT the local dev "terrain"/"terrain"
# pair from docker-compose.yml. Generate with: openssl rand -hex 24
# (hex, not base64 — this value gets spliced unescaped into the api service's
# DATABASE_URL below, and base64's `/` and `+` break URL parsing there)
POSTGRES_USER=terrain
POSTGRES_PASSWORD=
POSTGRES_DB=terrain

# Your real domain, pointed at this server's IP (A/AAAA record) before you
# bring the stack up — Caddy requests a Let's Encrypt cert for it on first
# boot. Leave as localhost to test the prod images locally — Caddy still
# enforces HTTPS in that case (via its own internal CA, not Let's Encrypt),
# it does not serve plain HTTP, so local requests need `curl -k` or the
# internal root trusted.
DOMAIN=
