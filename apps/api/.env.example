# Copy to .env and fill in real values. Never commit .env (already gitignored).

# Postgres connection string. Local dev matches docker-compose.yml (port 5433).
# In production, point at your managed/self-hosted Postgres and use a strong,
# unique password (not the local dev "terrain"/"terrain" default).
DATABASE_URL="postgresql://terrain:terrain@localhost:5433/terrain?schema=public"

# JWT signing secret for session cookies. Required, >= 32 chars — the app
# refuses to start otherwise. Generate a unique value per environment:
#   openssl rand -base64 48
# Rotating this value invalidates every existing session (acceptable; there is
# no server-side session store to clean up separately).
JWT_SECRET=

# Comma-separated list of origins allowed to call the API with credentials
# (browser cookie auth). Must match exactly (scheme + host + port), e.g.:
#   CORS_ORIGIN=https://terrain.example.com
# For local dev this defaults to http://localhost:5180 if unset.
CORS_ORIGIN=http://localhost:5180

# development | production. Controls: secure-cookie enforcement and refusing
# known placeholder JWT_SECRET values.
NODE_ENV=development

# Set to "1" only when a reverse proxy that strips/sets X-Forwarded-* sits
# directly in front of this process (e.g. Caddy in docker-compose.prod.yml —
# already set there). Leave unset otherwise: trusting X-Forwarded-For without
# a real proxy in front lets a client spoof its own IP and bypass rate
# limiting. Deliberately separate from NODE_ENV, which is baked into the
# Docker image regardless of deployment topology.
TRUST_PROXY=

PORT=3000
